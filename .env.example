# ============================================================
# KnowVault 环境变量示例 —— 复制为 .env 后填入真实值
# 严禁把真实 Key 提交进仓库（.gitignore 已忽略 .env）
#
# 两种运行方式共用本文件：
#   A. Docker Compose（推荐给演示 / 陌生人复现）
#      cp .env.example .env
#      docker compose up -d --build
#      浏览器打开 http://localhost:8080
#   B. .NET Aspire 本地开发
#      dotnet run --project aspire/KnowVault.AppHost
#
# 后端配置键是 Ai:DeepSeekApiKey / Ai:SiliconFlowApiKey
# （环境变量 Ai__DeepSeekApiKey / Ai__SiliconFlowApiKey）。
# 本文件使用短名；AppHost 与 docker-compose.yml 会做映射。
# ============================================================

# ---------- 模型 Key（两种方式都需要，留空时应用仍能启动，但上传/问答会失败） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 一个 Key 同时用于 Embeddings 与 Rerank；Embedding 模型必须与 Qdrant 的 1024 维保持一致
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ============================================================
# A. Docker Compose（本地演示；不要直接暴露到公网）
# ============================================================

# 宿主端口：被占用时改这里，Compose 与 OpenIddict issuer 会一起跟随
KNOWVAULT_HTTP_PORT=8080
KNOWVAULT_API_PORT=8081
QDRANT_HTTP_PORT=6333
# 9001 在部分 Windows 机器上属于系统保留端口，默认 9002
MINIO_CONSOLE_PORT=9002
RABBITMQ_MANAGEMENT_PORT=15672
SEQ_PORT=5341

# PostgreSQL（容器内 5432，不暴露宿主端口）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=knowvault-local-password
POSTGRES_DB=KnowVault

# RabbitMQ（不用 guest：guest 默认只允许 localhost 登录）
RABBITMQ_DEFAULT_USER=knowvault
RABBITMQ_DEFAULT_PASS=knowvault-local-password

# MinIO 原件存储（控制台端口见 MINIO_CONSOLE_PORT）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ABP 密钥：仅本地演示默认值。改 AUTH_CERT_PASSPHRASE 后需
# docker compose build --no-cache api 重新生成 openiddict.pfx
AUTH_CERT_PASSPHRASE=knowvault-local-cert-change-me
# API 与 DbMigrator 必须使用同一口令，否则加密数据无法跨进程解密
STRING_ENCRYPTION_PASSPHRASE=knowvault-local-encryption-change-me

# 首次迁移时是否种 demo / viewer 演示账号（密码 1q2w3E*，仅本地）
DEMO_SEED_ACCOUNTS=true

# ============================================================
# B. Aspire / dotnet run
# ============================================================

ASPNETCORE_ENVIRONMENT=Development

# ---------- Qdrant / 数据库 / 中间件连接（Aspire 通常自动注入，此处备用）----------
# 走 Aspire 时 Qdrant 的 Key 由 AppHost 自动注入（值在 AppHost user secrets 的 Parameters:qdrant-Key），不必手工填写；
# 手工容器路径（docker start kv-qdrant）未开启鉴权，QDRANT__SERVICE__API_KEY 为空，留空即可。
# Qdrant__Endpoint=http://localhost:6334   ⚠️ gRPC 端口是 6334，不是 REST 的 6333
# Qdrant__ApiKey=
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=knowvault;Username=postgres;Password=password

# ---------- ABP 密钥（本地开发请走 appsettings.secrets.json，此处供 CI / 容器注入）----------
# StringEncryption__DefaultPassPhrase: 加密落库字符串（ABP IStringEncryptionService）
# AuthServer__CertificatePassPhrase:  保护 OpenIddict 签名证书
#   ⚠️ 各宿主（HttpApi.Host / DbMigrator）必须使用同一口令，
#      否则 A 进程加密的数据 B 进程无法解密。
#   ⚠️ 本地开发：复制 src/KnowVault.HttpApi.Host/appsettings.secrets.json.example
#      为同目录下 appsettings.secrets.json（已被 .gitignore 忽略）后填入。
#      ABP 的 secrets.json 在配置链末尾加载，优先级高于环境变量。
#   ⚠️ 因此不要把 ConnectionStrings:Default 写进 secrets.json，否则会覆盖
#      Aspire 用 WithReference 注入的连接串（本地请以 AppHost 注入为准）。
#   生成口令：pwsh -c "[guid]::NewGuid().ToString('N')"
# StringEncryption__DefaultPassPhrase=
# AuthServer__CertificatePassPhrase=
