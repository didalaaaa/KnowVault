{
  "App": {
    "SelfUrl": "https://localhost:44300",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:5341/ingest/otlp/v1/traces"
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 30,
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 52428800
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=KnowVault;User ID=root;Password=myPassword;"
  },
  "Ai": {
    "DeepSeekApiKey": "",
    "DeepSeekBaseUrl": "https://api.deepseek.com",
    "DeepSeekModel": "deepseek-chat",
    "SiliconFlowApiKey": "",
    "SiliconFlowBaseUrl": "https://api.siliconflow.cn/v1",
    "SiliconFlowEmbeddingModel": "BAAI/bge-m3",
    "SiliconFlowRerankModel": "BAAI/bge-reranker-v2-m3",
    "RerankEnabled": true,
    "RerankCandidateCount": 20,
    "HybridEnabled": true,
    "Hybrid": {
      "DenseWeight": 1.0,
      "KeywordWeight": 1.0,
      "VariantWeight": 0.8,
      "RrfK": 60,
      "PerQueryCandidateCount": 10
    },
    "QueryRewriteEnabled": false,
    "QueryRewrite": {
      "MaxVariants": 2,
      "MinQuestionLength": 6,
      "MaxTokens": 200
    },
    "Pricing": {
      "Currency": "CNY",
      "DeepSeekInputPerMillion": 2,
      "DeepSeekOutputPerMillion": 8,
      "EmbeddingPerMillion": 0.07,
      "RerankPerMillion": 0.07
    },
    "HistoryMaxMessages": 6,
    "TopK": 5
  },
  "Documents": {
    "AllowedExtensions": [ ".pdf", ".docx", ".xlsx", ".md", ".markdown", ".html", ".htm" ],
    "MaxFileSizeMb": 50
  },
  "Ingest": {
    "ChunkSizeChars": 1000,
    "ChunkOverlapChars": 120
  },
  "Qdrant": {
    "Endpoint": "http://localhost:6334",
    "ApiKey": "",
    "VectorSize": 1024,
    "CollectionName": "knowvault_chunks"
  },
  "Minio": {
    "BucketName": "knowvault",
    "UseSsl": false
  },
  "AuthServer": {
    "Authority": "https://localhost:44300",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "KnowVault_Swagger"
  }
}