{
  "App": {
    "SelfUrl": "https://localhost:44300",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=KnowVault;User ID=root;Password=myPassword;"
  },
  "Ai": {
    "DeepSeekApiKey": "",
    "DeepSeekBaseUrl": "https://api.deepseek.com",
    "DeepSeekModel": "deepseek-chat",
    "QwenApiKey": "",
    "QwenBaseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "QwenEmbeddingModel": "text-embedding-v3",
    "QwenRerankModel": "gte-rerank",
    "TopK": 5
  },
  "Documents": {
    "AllowedExtensions": [ ".pdf", ".docx", ".xlsx", ".md", ".markdown", ".html", ".htm" ],
    "MaxFileSizeMb": 50
  },
  "Ingest": {
    "ChunkSizeChars": 1000,
    "ChunkOverlapChars": 120
  },
  "Qdrant": {
    "Endpoint": "http://localhost:6334",
    "VectorSize": 1024,
    "CollectionName": "knowvault_chunks"
  },
  "Minio": {
    "BucketName": "knowvault",
    "UseSsl": false
  },
  "AuthServer": {
    "Authority": "https://localhost:44300",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "KnowVault_Swagger"
  }
}